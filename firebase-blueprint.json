{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile representing a technician or admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "technician"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer receiving AC home services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerCode": { "type": "string", "maxLength": 30 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mobileNumber": { "type": "string", "minLength": 7, "maxLength": 20 },
        "altMobileNumber": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 },
        "area": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["fullName", "mobileNumber", "address", "createdAt"]
    },
    "ACUnit": {
      "title": "ACUnit",
      "description": "An Air Conditioner unit owned by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "brand": { "type": "string", "minLength": 1, "maxLength": 60 },
        "modelNumber": { "type": "string", "maxLength": 60 },
        "acType": { "type": "string", "enum": ["Split", "Window", "Inverter Split", "Other"] },
        "capacity": { "type": "string", "enum": ["1 ton", "1.5 ton", "2 ton", "Other"] },
        "serialNumber": { "type": "string", "maxLength": 60 },
        "installationDate": { "type": "string" },
        "warrantyExpiryDate": { "type": "string" },
        "locationInHome": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["customerId", "brand", "acType", "capacity", "createdAt"]
    },
    "ServiceRecord": {
      "title": "ServiceRecord",
      "description": "Permanent service and maintenance record for an AC unit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceCode": { "type": "string", "maxLength": 30 },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerMobile": { "type": "string", "maxLength": 20 },
        "customerAddress": { "type": "string", "maxLength": 300 },
        "acUnitId": { "type": "string" },
        "acBrand": { "type": "string", "maxLength": 60 },
        "acType": { "type": "string", "maxLength": 40 },
        "acCapacity": { "type": "string", "maxLength": 40 },
        "serviceDate": { "type": "string" },
        "serviceTime": { "type": "string", "maxLength": 20 },
        "serviceType": { "type": "string", "enum": ["General Service", "Deep Cleaning", "Gas Refilling", "Repair", "Installation", "Uninstallation", "Maintenance", "Other"] },
        "complaint": { "type": "string", "maxLength": 500 },
        "workPerformed": { "type": "string", "maxLength": 1000 },
        "cleaningDetails": { "type": "string", "maxLength": 500 },
        "gasLevelDetails": { "type": "string", "maxLength": 300 },
        "technicianNotes": { "type": "string", "maxLength": 500 },
        "labourCharge": { "type": "number" },
        "partsCost": { "type": "number" },
        "additionalCharges": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "UPI", "Card", "Other"] },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Partially Paid", "Unpaid"] },
        "nextRecommendedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Scheduled", "In Progress", "Completed", "Cancelled"] },
        "invoiceId": { "type": "string", "maxLength": 60 },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["customerId", "acUnitId", "serviceDate", "serviceType", "totalAmount", "createdAt"]
    },
    "PartItem": {
      "title": "PartItem",
      "description": "Spare part or material replaced or consumed during service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "serviceId": { "type": "string" },
        "acUnitId": { "type": "string" },
        "replacementReason": { "type": "string", "maxLength": 300 },
        "replacementDate": { "type": "string" },
        "partType": { "type": "string", "enum": ["consumed_part", "technician_tool"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "quantity", "unitPrice", "totalPrice", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled home service appointment with calendar support",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appointmentCode": { "type": "string", "maxLength": 30 },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 300 },
        "acUnitId": { "type": "string" },
        "acDetails": { "type": "string", "maxLength": 100 },
        "appointmentDate": { "type": "string" },
        "appointmentTime": { "type": "string", "maxLength": 20 },
        "serviceType": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Scheduled", "In Progress", "Completed", "Cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["customerId", "customerName", "customerPhone", "address", "appointmentDate", "appointmentTime", "serviceType", "status", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Official bill generated for service with reproducible PDF snapshot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "serviceId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerMobile": { "type": "string", "maxLength": 20 },
        "customerAddress": { "type": "string", "maxLength": 300 },
        "acUnitDetails": { "type": "string", "maxLength": 200 },
        "invoiceDate": { "type": "string" },
        "labourCharge": { "type": "number" },
        "partsCost": { "type": "number" },
        "additionalCharges": { "type": "number" },
        "discount": { "type": "number" },
        "subtotal": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Partially Paid", "Unpaid"] },
        "nextServiceDate": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "warrantyTerms": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["invoiceNumber", "customerId", "invoiceDate", "totalAmount", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction history record against an invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "serviceId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "UPI", "Card", "Other"] },
        "paymentDate": { "type": "string" },
        "transactionRef": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 300 },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceId", "customerId", "amount", "paymentMethod", "paymentDate", "createdAt"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Company and technician profile settings for branding and bills",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 20 },
        "alternatePhone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string", "maxLength": 300 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "invoicePrefix": { "type": "string", "maxLength": 20 },
        "defaultCurrency": { "type": "string", "maxLength": 10 },
        "serviceReminderDays": { "type": "number" },
        "invoiceNotes": { "type": "string", "maxLength": 500 },
        "warrantyTerms": { "type": "string", "maxLength": 500 },
        "upiId": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string" }
      },
      "required": ["businessName", "phone"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for mechanic/admin"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered home customers"
    },
    "/acUnits/{acUnitId}": {
      "schema": "ACUnit",
      "description": "Registered AC units with brand and specifications"
    },
    "/services/{serviceId}": {
      "schema": "ServiceRecord",
      "description": "Service histories and job logs"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Service visit appointments"
    },
    "/parts/{partId}": {
      "schema": "PartItem",
      "description": "Parts and materials catalogue and usage records"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices and printable billing snapshots"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment logs and installments"
    },
    "/businessSettings/{settingsId}": {
      "schema": "BusinessSettings",
      "description": "Mechanic shop profile and bill presets"
    }
  }
}
